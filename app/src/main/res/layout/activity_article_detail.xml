<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Back Button (Min 48dp Touch Target) -->
        <ImageButton
            android:id="@+id/btn_detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_detail_back"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Quick Share & Bookmark Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_detail_share"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_share"
                android:src="@drawable/ic_share"/>

            <ImageButton
                android:id="@+id/btn_detail_bookmark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_bookmark"
                android:src="@drawable/ic_bookmark_saved"/>
        </LinearLayout>

    </RelativeLayout>

    <!-- Scrollable Article Reader Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Header Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#FFB71C1C">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="ARTICLE BANNER IMAGE"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Article Headline & Author Metadata Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@color/surface_light">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_ethiopia"
                    android:textColor="@color/badge_ethiopia"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/hero_article_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/hero_article_author"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"/>

                <!-- Reader Toolbar Controls (Font Size Customization A-/A+ & Audio) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#FFF0F0F0"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reader Mode Options:"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <!-- Decrease Font Button (Min 48dp Touch Target) -->
                    <Button
                        android:id="@+id/btn_font_decrease"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:text="A-"
                        android:textSize="16sp"
                        style="?android:attr/borderlessButtonStyle"/>

                    <!-- Increase Font Button (Min 48dp Touch Target) -->
                    <Button
                        android:id="@+id/btn_font_increase"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:text="A+"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        style="?android:attr/borderlessButtonStyle"/>

                    <!-- Listen Audio Action Button (Min 48dp Touch Target) -->
                    <ImageButton
                        android:id="@+id/btn_listen_audio"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_listen"
                        android:src="@drawable/ic_audio_listen"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider_color"/>

                <!-- Main Body Text (High Contrast Outdoor Sunlight Legibility) -->
                <TextView
                    android:id="@+id/tv_article_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/article_full_body"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>